# 正式签名配置模板
#
# 用法：
#   1. 复制本文件为 keystore.properties
#   2. 填入你自己的 keystore 信息
#   3. keystore.properties 已在 .gitignore 中，不会被提交
#
# 生成 keystore：
#   keytool -genkeypair -v -keystore suzubot-release.jks \
#     -alias YOUR_ALIAS -keyalg RSA -keysize 2048 -validity 36500

storeFile=suzubot-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
