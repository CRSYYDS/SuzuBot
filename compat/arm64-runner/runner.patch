diff --git a/app/src/main/java/dev/armbat/PicoArchive.kt b/app/src/main/java/dev/armbat/PicoArchive.kt
new file mode 100644
index 0000000..9df9be4
--- /dev/null
+++ b/app/src/main/java/dev/armbat/PicoArchive.kt
@@ -0,0 +1,30 @@
+package dev.armbat
+
+import java.io.File
+import java.io.IOException
+import java.security.MessageDigest
+
+internal object PicoArchive {
+    const val PACKAGE = "com.tencent.qqlite"
+    const val ENTRY = "com.tencent.qqnt.watch.app.JumpActivity"
+    private const val SIZE = 52482333L
+    private const val SHA256 = "4ddd3451f40e49792b651ed5c31176a29c44b0d4b5f38d3c59558b6085f5025c"
+
+    fun matches(file: File): Boolean {
+        if (!file.isFile || file.length() != SIZE) return false
+        val digest = MessageDigest.getInstance("SHA-256")
+        try {
+            file.inputStream().use { input ->
+                val buffer = ByteArray(64 * 1024)
+                while (true) {
+                    val length = input.read(buffer)
+                    if (length < 0) break
+                    digest.update(buffer, 0, length)
+                }
+            }
+        } catch (_: IOException) {
+            return false
+        }
+        return digest.digest().joinToString("") { "%02x".format(it.toInt() and 0xff) } == SHA256
+    }
+}
